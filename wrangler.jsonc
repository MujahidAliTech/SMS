{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taleemcloud-saas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "API_VERSION": "v1",
    "APP_NAME": "TaleemCloud SaaS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sms-db",
      "database_id": "e3e3bdd5-fb0f-48e0-8031-1f9de370cf61",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "taleemcloud-assets",
      "preview_bucket_name": "taleemcloud-assets-preview"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
