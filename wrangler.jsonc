{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taleemcloud-saas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "API_VERSION": "v1",
    "APP_NAME": "TaleemCloud SaaS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taleemcloud-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "taleemcloud-assets",
      "preview_bucket_name": "taleemcloud-assets-preview"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  }
}
